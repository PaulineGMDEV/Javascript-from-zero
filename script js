/*Array tricks**/
const snacks=["chai","mandazi"];

snacks.push("samosa");  /*adds at the end*/
console.log(snacks);

snacks.pop();    /*removes at the end*/
console.log(snacks);

snacks.unshift("mango");  /*adds at the start*/
console.log(snacks)

snacks.shift();
console.log(snacks);    /*removes from the start*/

console.log(snacks.length);  /*how many items are there*/


